# Optional. start.bat funktioniert ohne .env-Datei.
TRACKER_SECRET_KEY=bitte-fuer-produktivbetrieb-aendern
TRACKER_NO_DEMO=0
# Optional für die Cloud-Version. Lokal leer lassen, damit SQLite verwendet wird.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Mehrbenutzer-Login mit Supabase Auth
TRACKER_AUTH_REQUIRED=0
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
TRACKER_SECURE_COOKIES=0
